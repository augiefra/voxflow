# Adresses de diffusion de VoxFlow (dépôt public augiefra/voxflow, releases seulement).

# Adresse du flux Sparkle, gravée dans l'app : ne plus la changer après la première diffusion.
APPCAST_URL="https://github.com/augiefra/voxflow/releases/latest/download/appcast.xml"
# Adresse de téléchargement d'une version ({version} est remplacé).
DOWNLOAD_URL_TEMPLATE="https://github.com/augiefra/voxflow/releases/download/v{version}/VoxFlow-{version}.dmg"
# Dépôt GitHub (public) qui héberge les versions.
GITHUB_REPO="augiefra/voxflow"
# Profil du trousseau créé par : xcrun notarytool store-credentials "VoxFlowNotary" …
NOTARY_PROFILE="VoxFlowNotary"
# Compte de la clé EdDSA Sparkle dans le trousseau (generate_keys --account voxflow).
SPARKLE_ACCOUNT="voxflow"
